# =============================================================================
#  PRODUCTION - Plateforme de recensement FJCS
#  Base : Prisma Postgres (intégration Vercel)
#
#  Sur Vercel, ces variables se saisissent dans Settings > Environment Variables
#  (environnement Production). Ce fichier ne sert que pour un hébergement
#  autonome (VPS) ou un build de production local.
# =============================================================================

# --- Base de données ---------------------------------------------------------
# L'intégration Prisma Postgres de Vercel crée ses propres variables, avec le
# préfixe choisi à l'installation (ici « prod_fjcs ») :
#   PROD_FJCS_DATABASE_URL, PROD_FJCS_DIRECT_URL, ...
# Le projet les détecte automatiquement : aucun renommage n'est nécessaire.
# Renseignez ci-dessous uniquement en hébergement autonome.
#
# DATABASE_URL : connexion utilisée par l'application (poolée si disponible).
# DIRECT_URL   : connexion directe, utilisée par les migrations et le seed.
# Les deux doivent commencer par postgresql:// (et non prisma+postgres://).
DATABASE_URL=""
DIRECT_URL=""

# --- Authentification (Auth.js) ----------------------------------------------
AUTH_SECRET=""                  # openssl rand -base64 32
AUTH_TRUST_HOST="true"

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://votre-domaine.vercel.app"

# --- Anti-abus (optionnel mais recommandé) -----------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Protection des données --------------------------------------------------
IP_HASH_SALT=""                 # openssl rand -hex 24

# --- Données de démonstration ------------------------------------------------
# Absente ou "false" en production (le code refuse de toute façon d'afficher
# les profils fictifs lorsque NODE_ENV=production).
SHOW_DEMO_DATA="false"
