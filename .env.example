# --- Base de données -------------------------------------------------------
# PostgreSQL (docker compose local : voir docker-compose.yml)
DATABASE_URL="postgresql://fjcs:fjcs_dev_password@localhost:5433/fjcs_recensement?schema=public"

# --- Authentification (Auth.js) -------------------------------------------
# Générer : openssl rand -base64 32
AUTH_SECRET=""
# Obligatoire derrière un proxy / en production (Vercel le gère automatiquement)
AUTH_TRUST_HOST="true"

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Anti-abus (optionnel) ---------------------------------------------------
# Cloudflare Turnstile : si les deux clés sont renseignées, le CAPTCHA est activé
# sur le formulaire public. Sinon, seuls le honeypot et le rate limiting s'appliquent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Mesure d'audience (optionnel) -------------------------------------------
# Identifiant de mesure GA4 (Administration > Flux de données), format G-XXXXXXXXXX.
# Vide : aucun script Google n'est chargé. Chargé sur le site public uniquement.
# Ce nom ne doit jamais être préfixé : Next.js fige les NEXT_PUBLIC_* au build.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Développement uniquement : affiche les profils de démonstration (npm run db:seed-demo)
SHOW_DEMO_DATA="false"

# --- Divers -----------------------------------------------------------------
# Sel utilisé pour hasher les adresses IP dans les journaux (jamais l'IP en clair)
IP_HASH_SALT="change-me"
